{
    // 小花火 AI assistant: forwards the site's chat to Google Gemini.
    // Deploy:  npx wrangler deploy           (from this folder)
    // Key:     npx wrangler secret put GEMINI_API_KEY
    // Local:   put GEMINI_API_KEY=... in .dev.vars (git-ignored), then npx wrangler dev
    "name": "hanabi-assistant",
    "main": "src/index.js",
    "compatibility_date": "2026-09-23",

    "vars": {
        // fast, good at CJK, on the free tier (gemini-2.5-* is closed to new keys); change here to switch
        "MODEL": "gemini-3.8-flash",
        // used when the main model answers 503 "high demand"
        "FALLBACK_MODEL": "gemini-3.5-flash-lite",
        // the site, plus the local test servers
        "ALLOWED_ORIGINS": "https://hanabirn.xyz,https://hanabirn.github.io,http://localhost:8765,http://localhost:8767"
    },

    // at most 8 messages a minute per visitor (IP)
    "ratelimits": [
        { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
    ],

    "observability": { "enabled": true }
}
