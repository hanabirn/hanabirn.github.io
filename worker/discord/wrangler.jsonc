{
    // hanabi-discord: the site's Discord bot (/quiz /grammar /dictionary), answering
    // Discord's HTTP interactions. See README.md for setting up the Discord app.
    // Deploy:    npx wrangler deploy                 (from this folder)
    // Commands:  node register.mjs                   (needs DISCORD_BOT_TOKEN in .dev.vars)
    // Local:     node test.mjs                       (runs wrangler dev against a fake Discord)
    "name": "hanabi-discord",
    "main": "src/index.js",
    "compatibility_date": "2026-09-23",

    "vars": {
        // where the word lists and grammar lessons are read from
        "SITE": "https://hanabirn.xyz",
        // the Discord app (Developer Portal → General Information); both public by design.
        // The bot token is NOT here: it is only needed by register.mjs, from .dev.vars.
        "DISCORD_APPLICATION_ID": "1558216315670630490",
        "DISCORD_PUBLIC_KEY": "5bb7284b7a9115b1205afe81d2e1012d80d0b55af87e810b93b4b3dbf3942e95"
    },

    // each visitor's /language choice, "lang:<user id>" -> zh / zhs / en / ja / ko / ru / fr / es / de
    // created with: npx wrangler kv namespace create PREFS
    "kv_namespaces": [
        { "binding": "PREFS", "id": "69ef919a578c4937bccf729517c4a449" }
    ],

    "observability": { "enabled": true }
}
